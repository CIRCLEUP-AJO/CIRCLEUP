NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_CIRCLE_FACTORY_ADDRESS=
NEXT_PUBLIC_REPUTATION_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_INDEXER_URL=http://localhost:3001

# ── Security headers ──────────────────────────────────────────────────────────

# URI to receive Content-Security-Policy violation reports.
# Leave empty to disable violation reporting.
# Example: https://your-csp-endpoint.example.com/csp-report
NEXT_PUBLIC_CSP_REPORT_URI=

# Set to "true" to switch from Content-Security-Policy-Report-Only (safe
# observation mode) to enforced Content-Security-Policy.
# Review violation reports before enabling enforcement in production.
# See docs/SECURITY_HEADERS.md for the rollout procedure.
NEXT_PUBLIC_CSP_ENFORCE=false

# ── Optional telemetry ────────────────────────────────────────────────────────

# Set to "true" to enable opt-in transaction lifecycle telemetry.
# See app/src/lib/telemetry.ts for the full privacy specification.
NEXT_PUBLIC_TELEMETRY_ENABLED=false

# ── Build metadata (set by CI/CD, optional in local dev) ─────────────────────

# Active network label surfaced in diagnostics ("testnet" | "mainnet" | "custom").
# Defaults to "unknown" when unset.
NEXT_PUBLIC_ACTIVE_NETWORK=testnet

# Application version string surfaced in diagnostics (e.g. "0.1.0").
# Defaults to "unknown" when unset. Typically set from package.json in CI.
NEXT_PUBLIC_APP_VERSION=

# Canonical public URL of the deployed app, used by sitemap.ts and robots.ts.
# Leave empty in local development (falls back to http://localhost:3000).
NEXT_PUBLIC_SITE_URL=
