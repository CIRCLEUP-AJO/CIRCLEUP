{
  "name": "@circleup/app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "../node_modules/.bin/tsc -p ../sdk/tsconfig.json",
    "build": "next build",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "prebuild": "../node_modules/.bin/tsc -p ../sdk/tsconfig.json",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest --run",
    "test:visual": "playwright test -c ../tests/visual/playwright.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "license:check": "license-checker --production --excludePrivatePackages --out licenses-app.csv --csv",
    "license:summary": "license-checker --production --excludePrivatePackages --summary"
  },
  "dependencies": {
    "@circleup/sdk": "^0.1.0",
    "@stellar/stellar-sdk": "^17.2.1",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^17.2.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.58.0",
    "next": "14.2.30",
    "react": "^18.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "14.2.5",
    "jsdom": "^30.1.3",
    "license-checker": "^25.0.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
