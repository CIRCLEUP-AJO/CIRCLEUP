{
  "$comment": "Performance budgets for the offline perf suite (tests/perf/perf-budget.test.ts). Tier-keyed entries are exercised against deterministic fixtures defined in tests/perf/fixture-profiles.json. See docs/PERFORMANCE_BUDGETS.md.",
  "version": "2.0.0",
  "updatedAt": "2026-11-20",
  "baselinePolicy": {
    "updateRequiresEvidence": true,
    "evidenceFormat": "PR description must include before/after measured values, the command used, and the reason the old budget was wrong",
    "reviewer": "perf budget change requires maintainer sign-off",
    "fixtureTiers": "small|typical|high-water defined in tests/perf/fixture-profiles.json"
  },
  "environmentVariance": {
    "ciVarianceFactor": 1.5,
    "note": "CI runners are slower and noisier than local machines; budgets include this headroom."
  },
  "api": {
    "circleList": {
      "small": { "queryMs": 20, "payloadKb": 32 },
      "typical": { "queryMs": 40, "payloadKb": 160 },
      "highWater": { "queryMs": 80, "payloadKb": 320 }
    },
    "circleDetail": {
      "minimal": { "queryMs": 20, "payloadKb": 32 },
      "typical": { "queryMs": 40, "payloadKb": 256 },
      "highWater": { "queryMs": 120, "payloadKb": 2048 }
    },
    "memberContributions": {
      "small": { "queryMs": 20, "payloadKb": 32 },
      "typical": { "queryMs": 40, "payloadKb": 160 },
      "highWater": { "queryMs": 80, "payloadKb": 320 }
    },
    "reputationProfile": { "queryMs": 20, "payloadKb": 8 }
  },
  "render": {
    "circleList": { "small": 20, "typical": 40, "highWater": 80 },
    "circleDetail": { "minimal": 20, "typical": 40, "highWater": 120 }
  },
  "payload": {
    "circleList": { "small": 32, "typical": 160, "highWater": 320 },
    "circleDetail": { "minimal": 32, "typical": 256, "highWater": 2048 },
    "memberContributions": { "small": 32, "typical": 160, "highWater": 320 }
  },
  "bundle": {
    "firstLoadJsKb": 300,
    "pageChunkKb": 200
  }
}
