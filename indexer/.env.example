DATABASE_URL=postgresql://postgres:password@localhost:5432/circleup
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
CIRCLE_FACTORY_ADDRESS=
REPUTATION_ADDRESS=
USDC_ADDRESS=
PORT=3001
# Ledger to start indexing from (0 = genesis)
START_LEDGER=0
# How often to poll the RPC for new events, in milliseconds
POLL_INTERVAL_MS=5000
# Max events fetched per getEvents() call (Soroban RPC caps this at 10000)
EVENTS_LIMIT=100
# Comma-separated allow-list for CORS (e.g. https://app.circleup.xyz,https://staging.circleup.xyz)
# Each entry must be a bare http(s) origin — no path/query. If unset (or every
# entry is invalid), all origins are allowed in development; with
# NODE_ENV=production this is a startup error instead of a silent wide-open CORS policy.
ALLOWED_ORIGINS=
# Number of reverse-proxy hops between the client and this process (used for
# rate-limit client identity). 0 = trust nothing, use the direct socket
# address. Set to 1 behind a single load balancer/reverse proxy.
TRUST_PROXY_HOPS=0
# Per-IP rate limits, one bucket per route class (list/detail/history share
# RATE_LIMIT_WINDOW_MS; health has its own generous cap so uptime monitors
# are never throttled by load on the other classes).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LIST_MAX=30
RATE_LIMIT_DETAIL_MAX=100
RATE_LIMIT_HISTORY_MAX=30
RATE_LIMIT_HEALTH_MAX=300

# ── Operational health (GET /health) ──────────────────────────────────────────
# Ledgers the indexer may fall behind the chain tip before /health reports
# "degraded". Default 1000 ≈ ~83 minutes at 5 s/ledger. Tune down for tighter
# alerting (e.g. 200 ≈ 16 min) or up for environments running deliberate
# re-index passes.
INDEXER_LAG_ALERT_LEDGERS=1000
# Maximum round difference between DB current_round and on-chain state before
# the contract drift check transitions to "degraded". Default 1.
DRIFT_ROUND_THRESHOLD=1
# Timeout in milliseconds for each individual health check component.
# Default 5000 ms.
HEALTH_TIMEOUT_MS=5000
