DATABASE_URL=postgresql://postgres:password@localhost:5432/circleup
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
CIRCLE_FACTORY_ADDRESS=
REPUTATION_ADDRESS=
USDC_ADDRESS=
PORT=3001
# Ledger to start indexing from (0 = genesis)
START_LEDGER=0
# Comma-separated allow-list for CORS (e.g. https://app.circleup.xyz,https://staging.circleup.xyz)
# If unset, all origins are allowed — fine for local dev, not for production.
ALLOWED_ORIGINS=
# Per-IP rate limit applied to every API route
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
