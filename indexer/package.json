{
  "name": "@circleup/indexer",
  "version": "0.1.0",
  "description": "Event indexer for CircleUp — Postgres + REST API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate": "node -e \"require('./dist/db/migrate').runMigrations()\"",
    "migrate:dev": "ts-node src/db/migrate.ts",
    "migrate:status": "ts-node src/db/migrate.ts --status",
    "migrate:check": "ts-node src/db/migrate.ts --check",
    "db:setup": "docker compose up -d postgres && ts-node src/db/migrate.ts",
    "db:reset": "ts-node src/db/replay.ts --from=0",
    "replay": "ts-node src/db/replay.ts",
    "replay:dry-run": "ts-node src/db/replay.ts --dry-run --from=0",
    "reconcile": "ts-node src/db/reconcile.ts",
    "reconcile:repair": "ts-node src/db/reconcile.ts --repair",
    "reconcile:circle": "ts-node src/circleReconciliation.ts",
    "explain": "ts-node src/db/explain.ts",
    "test": "node --require ts-node/register --test src/indexer.test.ts src/api.test.ts src/api.db.test.ts src/config.test.ts src/db/migrate.test.ts src/db/pool.test.ts src/db/replay.test.ts src/db/replay.fixtures.test.ts src/db/dbGuard.test.ts src/groupRounds.test.ts src/health.test.ts src/fixtures/incident.test.ts src/shutdown.test.ts src/eventSchemas.test.ts src/circleReconciliation.test.ts src/csvExport.test.ts src/indexer.ordering.test.ts src/indexer.batch.test.ts",
    "test:incidents": "node --require ts-node/register --test src/fixtures/incident.test.ts",
    "license:check": "license-checker --production --excludePrivatePackages --out licenses-indexer.csv --csv",
    "license:summary": "license-checker --production --excludePrivatePackages --summary"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.2.1",
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "license-checker": "^25.0.1",
    "supertest": "^7.3.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
