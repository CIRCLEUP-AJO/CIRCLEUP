# Contract addresses — populated automatically by deploy.ts
CIRCLE_FACTORY_ADDRESS=
REPUTATION_ADDRESS=
USDC_ADDRESS=

# Network
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# stellar-cli identity name used for deployment (run: stellar keys generate deployer --network testnet)
DEPLOYER_IDENTITY=deployer

# Public key of the deployer account (run: stellar keys address deployer).
# Required by funding-diagnostics.ts to check account balance before deploying.
DEPLOYER_PUBLIC_KEY=

# Target network for deployment scripts ("testnet" | "mainnet" | "futurenet").
# Overrides --network CLI flag when set. Defaults to "testnet".
NETWORK=testnet

# Active CircleUp environment profile used by validate-env.ts.
# One of: testnet | staging | production. May also be passed via --profile flag.
CIRCLEUP_PROFILE=testnet
