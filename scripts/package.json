{
  "name": "@circleup/scripts",
  "version": "0.1.0",
  "scripts": {
    "typecheck": "tsc --noEmit --module es2022 --moduleResolution bundler",
    "deploy:testnet": "ts-node src/deploy.ts",
    "mainnet:readiness": "ts-node src/mainnet-readiness.ts",
    "seed:demo": "ts-node src/seed-demo.ts",
    "test:seed": "node -r ts-node/register --test src/seed-demo-policy.test.ts",
    "release-check": "ts-node src/release-check.ts",
    "validate-env": "ts-node src/validate-env.ts",
    "hash-artifacts": "ts-node src/check-artifact-hashes.ts --update",
    "verify-artifacts": "ts-node src/check-artifact-hashes.ts",
    "funding-diagnostics": "ts-node src/funding-diagnostics.ts",
    "validate-manifest": "ts-node src/deployment-manifest.ts",
    "check:env-parity": "ts-node src/check-env-parity.ts",
    "test": "node --require ts-node/register --test src/check-env-parity.test.ts src/release-check.test.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.2.1",
    "dotenv": "^18.0.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
