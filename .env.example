# ── CircleUp root environment example ─────────────────────────────────────────
#
# CircleUp is an npm-workspace monorepo. Each workspace that reads environment
# variables ships its own, authoritative .env.example with the full, commented
# list of variables it consumes:
#
#   indexer/.env.example  → Postgres + Soroban RPC + indexing/runtime tuning
#   app/.env.example      → Next.js public config (NEXT_PUBLIC_*) + security headers
#   scripts/.env.example  → deployer identity + contract addresses for deploy scripts
#
# Copy the workspace-specific file into place, e.g.:
#   cp indexer/.env.example indexer/.env
#   cp app/.env.example     app/.env.local
#   cp scripts/.env.example scripts/.env
#
# The union of variables referenced across the codebase is listed below for
# discoverability. Treat the workspace files above as the source of truth.
#
# This union is machine-checked by scripts/check-env-parity.mjs (run in CI):
# every name here must exist in a workspace .env.example or be read by code,
# and every documented default must match the runtime validator default.
# Entries marked "required" have no default and must be supplied explicitly.
# The checker reports variable names only — never configured values.

# ── indexer (see indexer/.env.example for the full list + comments) ───────────
# required — Postgres connection string (no default)
DATABASE_URL=postgresql://postgres:password@localhost:5432/circleup
# required — Soroban RPC endpoint (no default)
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# required — deployed CircleFactory contract id (no default)
CIRCLE_FACTORY_ADDRESS=
# required — deployed Reputation contract id (no default)
REPUTATION_ADDRESS=
# required — USDC token contract id (no default)
USDC_ADDRESS=
# optional — default 3001
PORT=3001
# optional — default 0
START_LEDGER=0
# optional — default "development" ("development" | "production" | "test")
NODE_ENV=development
# optional — default "testnet" ("testnet" | "mainnet"); used by scripts and SDK helpers
NETWORK=testnet
# required — Stellar network passphrase (no default); required by SDK transaction signing
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# CORS allow-list: comma-separated origins (e.g. https://app.circleup.xyz)
# optional — default empty (allows all origins in local dev)
ALLOWED_ORIGINS=
# optional — default 0 (0 = direct connection, no proxy hops)
TRUST_PROXY_HOPS=0
# Per-IP rate limits (requests per RATE_LIMIT_WINDOW_MS window) — all optional
# default 60000
RATE_LIMIT_WINDOW_MS=60000
# default 30
RATE_LIMIT_LIST_MAX=30
# default 100
RATE_LIMIT_DETAIL_MAX=100
# default 30
RATE_LIMIT_HISTORY_MAX=30
# default 300
RATE_LIMIT_HEALTH_MAX=300
# Timeout for each /health check component (ms) — optional, default 5000
HEALTH_TIMEOUT_MS=5000
# Indexer health: ledgers behind chain tip before /health reports "degraded"
# optional — default 1000
INDEXER_LAG_ALERT_LEDGERS=1000
# Max round difference between DB and on-chain before drift check degrades
# optional — default 1
DRIFT_ROUND_THRESHOLD=1
# Open event_failures rows at which /health reports "degraded" — optional, default 1
EVENT_FAILURE_ALERT_COUNT=1
# Min attempts on an open failure that marks it "recurring" — optional, default 2
EVENT_FAILURE_RECURRING_ATTEMPTS=2
# Profile label for deployment environment (e.g. "testnet" | "mainnet")
# optional — default "testnet"
CIRCLEUP_PROFILE=testnet
# Plus: poll/retry/backoff and backfill tuning — see indexer/.env.example.
# Key tuning vars (all optional; defaults shown and validated by the parity checker):
# default "info"
LOG_LEVEL=info
# How often to poll the Soroban RPC for new events (ms, min 500) — default 5000
POLL_INTERVAL_MS=5000
# Max events per getEvents() call (Soroban RPC caps at 10000) — default 100
EVENTS_LIMIT=100
# RPC retry: max attempts before failing a single RPC call — default 4
RPC_RETRY_MAX_ATTEMPTS=4
# RPC retry: base delay in ms (doubles each attempt, with jitter) — default 500
RPC_RETRY_BASE_DELAY_MS=500
# Poll-cycle backoff (ms) — applied after consecutive poll failures
# default 1000
POLL_BACKOFF_INITIAL_MS=1000
# default 60000
POLL_BACKOFF_MAX_MS=60000
# default 2.0
POLL_BACKOFF_MULTIPLIER=2.0
# How many ledgers to process per backfill batch — default 100
BACKFILL_MAX_LEDGERS=100
# default 10000
BACKFILL_MAX_EVENTS=10000
# default 100
BACKFILL_MAX_PAGES=100
# Postgres connection pool settings — all optional
# default 5
DB_CONNECT_MAX_RETRIES=5
# default 1000
DB_CONNECT_BASE_DELAY_MS=1000
# default 10
DB_POOL_MAX=10
# default 30000
DB_ACQUIRE_TIMEOUT_MS=30000
# default 30000
DB_STATEMENT_TIMEOUT_MS=30000
# Graceful shutdown grace period before force-exit (ms) — optional, default 5000
SHUTDOWN_GRACE_PERIOD_MS=5000

# ── app (see app/.env.example for the full list + comments) ───────────────────
# required — Soroban RPC endpoint (no default)
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# required — Stellar network passphrase (no default)
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# required — deployed CircleFactory contract id (no default)
NEXT_PUBLIC_CIRCLE_FACTORY_ADDRESS=
# required — deployed Reputation contract id (no default)
NEXT_PUBLIC_REPUTATION_ADDRESS=
# required — USDC token contract id (no default)
NEXT_PUBLIC_USDC_ADDRESS=
# optional — default http://localhost:3001
NEXT_PUBLIC_INDEXER_URL=http://localhost:3001
# CSP enforcement: set "true" to enforce (vs report-only mode)
# optional — default false
NEXT_PUBLIC_CSP_ENFORCE=false
# CSP violation report endpoint (leave empty to disable reporting)
# optional — default empty
NEXT_PUBLIC_CSP_REPORT_URI=
# Opt-in transaction lifecycle telemetry (set "true" to enable)
# optional — default false
NEXT_PUBLIC_TELEMETRY_ENABLED=false
# App version string surfaced in diagnostics (set from package.json in CI)
# optional — default empty
NEXT_PUBLIC_APP_VERSION=
# Canonical public URL for sitemap/robots (empty in local dev)
# optional — default empty
NEXT_PUBLIC_SITE_URL=
# Port for visual regression test fixture server
# optional — default 3100
VISUAL_FIXTURE_PORT=3100

# ── scripts (see scripts/.env.example) ─────────────────────────────────────────
# Deployer identity for contract deployment (generated by stellar keys generate)
# optional — default "deployer"
DEPLOYER_IDENTITY=deployer
# Deployer public key (G-address, populated after stellar keys generate)
# optional — default empty
DEPLOYER_PUBLIC_KEY=
# Set to "true" to allow smoke tests against mainnet (dangerous — default false)
# optional — default false
SMOKE_ALLOW_MAINNET=false
# Deployed contract addresses (populated by npm run deploy:testnet)
# required — no default; must be set before running deploy scripts
