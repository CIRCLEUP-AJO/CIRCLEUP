# ── CircleUp root environment example ─────────────────────────────────────────
#
# CircleUp is an npm-workspace monorepo. Each workspace that reads environment
# variables ships its own, authoritative .env.example with the full, commented
# list of variables it consumes:
#
#   indexer/.env.example  → Postgres + Soroban RPC + indexing/runtime tuning
#   app/.env.example      → Next.js public config (NEXT_PUBLIC_*) + security headers
#   scripts/.env.example  → deployer identity + contract addresses for deploy scripts
#
# Copy the workspace-specific file into place, e.g.:
#   cp indexer/.env.example indexer/.env
#   cp app/.env.example     app/.env.local
#   cp scripts/.env.example scripts/.env
#
# The union of variables referenced across the codebase is listed below for
# discoverability. Treat the workspace files above as the source of truth.

# ── indexer (see indexer/.env.example for the full list + comments) ───────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/circleup
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
CIRCLE_FACTORY_ADDRESS=
REPUTATION_ADDRESS=
USDC_ADDRESS=
PORT=3001
START_LEDGER=0
# Runtime environment label ("development" | "production" | "test")
NODE_ENV=development
# Active network label ("testnet" | "mainnet") — used by scripts and SDK helpers
NETWORK=testnet
# Stellar network passphrase — required by SDK transaction signing
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# CORS allow-list: comma-separated origins (e.g. https://app.circleup.xyz)
# Leave empty in local dev to allow all origins.
ALLOWED_ORIGINS=
# Reverse-proxy hop count for client IP detection (0 = direct connection)
TRUST_PROXY_HOPS=0
# Per-IP rate limits (requests per RATE_LIMIT_WINDOW_MS window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LIST_MAX=30
RATE_LIMIT_DETAIL_MAX=100
RATE_LIMIT_HISTORY_MAX=30
RATE_LIMIT_HEALTH_MAX=300
# Timeout for each /health check component (ms)
HEALTH_TIMEOUT_MS=5000
# Plus: poll/retry/backoff and backfill tuning — see indexer/.env.example.

# ── app (see app/.env.example for the full list + comments) ───────────────────
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_CIRCLE_FACTORY_ADDRESS=
NEXT_PUBLIC_REPUTATION_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_INDEXER_URL=http://localhost:3001
# Plus: CSP, telemetry, build metadata, canonical site URL.

# ── scripts (see scripts/.env.example) ─────────────────────────────────────────
# Deployer identity + deployed contract addresses (populated by npm run deploy:testnet).
