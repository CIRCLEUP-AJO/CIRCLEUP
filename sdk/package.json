{
  "name": "@circleup/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for CircleUp on Stellar Soroban",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsc --watch",
    "test": "vitest --run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit --strict",
    "typecheck:examples": "tsc -p examples/tsconfig.json",
    "check:api": "npm run clean && npm run build && tsc -p examples/tsconfig.dist.json && node scripts/check-public-api.cjs",
    "prepublishOnly": "npm run check:api"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
