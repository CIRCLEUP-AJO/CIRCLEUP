# CircleUp — Production profile
#
# Targets Stellar Mainnet.
#
# WARNING: All validation rules are strict for this profile.
#   - STELLAR_RPC_URL must not contain any testnet hostname.
#   - NETWORK_PASSPHRASE must be exactly "Public Global Stellar Network ; September 2015".
#   - All contract addresses must be set.
#   - This file must NOT contain any secret keys or private keys.
#
# Usage:
#   CIRCLEUP_PROFILE=production npx ts-node scripts/src/validate-env.ts
#   (or) npx ts-node scripts/src/validate-env.ts --profile production
#
# Secrets (ADMIN_SECRET_KEY, etc.) must never appear here.
# Inject them via CI environment variables or a secret manager (e.g., Vault, AWS SSM).

CIRCLEUP_PROFILE=production

# Mainnet RPC — must NOT reference testnet or futurenet.
# Replace with a production-grade RPC provider or your own node.
STELLAR_RPC_URL=https://soroban-rpc.stellar.org

# Must be exactly this string.  validate-env.ts will fail if it does not match.
NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

# Horizon (mainnet)
HORIZON_URL=https://horizon.stellar.org

# Contract addresses — all required.
# Set these to the addresses from the official mainnet deployment.
CIRCLE_FACTORY_ADDRESS=
REPUTATION_ADDRESS=
USDC_ADDRESS=

# Friendbot is NOT available on mainnet.
FRIENDBOT_URL=
