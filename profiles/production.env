# CircleUp — Production profile
#
# Targets Stellar Mainnet.
#
# WARNING: All validation rules are strict for this profile.
#   - STELLAR_RPC_URL must not contain any testnet hostname.
#   - NETWORK_PASSPHRASE must be exactly "Public Global Stellar Network ; September 2015".
#   - All contract addresses must be set.
#   - This file must NOT contain any secret keys or private keys.
#
# Usage:
#   CIRCLEUP_PROFILE=production npx ts-node scripts/src/validate-env.ts
#   (or) npx ts-node scripts/src/validate-env.ts --profile production
#
# Secrets (ADMIN_SECRET_KEY, etc.) must never appear here.
# Inject them via CI environment variables or a secret manager (e.g., Vault, AWS SSM).
#
# ---------------------------------------------------------------------------
# Production container contract
# ---------------------------------------------------------------------------
# The app and indexer are packaged as minimal production container images
# (see Dockerfile.app and Dockerfile.indexer at the repository root). The
# contract below is what those images expect at runtime. Operators must
# satisfy it when deploying; CI builds the images and verifies startup with a
# minimal environment.
#
# Runtime user:
#   - Both images run as a non-root, least-privilege user (uid/gid 1001).
#   - No shell login; the process is the container entrypoint.
#
# Exposed ports:
#   - app:     3000/tcp (Next.js standalone server)
#   - indexer: no inbound port; it is a worker process (health via command).
#
# Writable paths:
#   - /tmp is writable for both images (scratch space only).
#   - The app image's standalone output and the indexer's build artifacts are
#     read-only at runtime; do not mount secrets or state into them.
#   - Any persistent state must be provided via external services (DB, RPC),
#     not via writable container paths.
#
# Health command:
#   - app:     HTTP GET /api/health on port 3000 (readiness contract).
#   - indexer: `node dist/healthcheck.js` (exit 0 = ready).
#   - Health behavior must match the service readiness contract; probes must
#     not require secrets to succeed.
#
# Environment contract:
#   Required (must be provided by the deployment platform / secret manager):
#     CIRCLEUP_PROFILE, STELLAR_RPC_URL, NETWORK_PASSPHRASE, HORIZON_URL,
#     CIRCLE_FACTORY_ADDRESS, REPUTATION_ADDRESS, USDC_ADDRESS,
#     ADMIN_PUBLIC_KEY, ADMIN_IDENTITY
#   Optional:
#     FRIENDBOT_URL (must be empty on mainnet), log level, port overrides.
#   Secrets (ADMIN_SECRET_KEY, etc.) are injected at runtime only and must
#   never be baked into images or committed to this file.
#
# Secret scanning in CI:
#   - CI scans the final images for accidental source secrets before publish.
#   - Builds fail if any credential material is detected in image layers.
#   - Images exclude development dependencies and secrets by construction.
# ---------------------------------------------------------------------------

CIRCLEUP_PROFILE=production

# Mainnet RPC — must NOT reference testnet or futurenet.
# Replace with a production-grade RPC provider or your own node.
STELLAR_RPC_URL=https://soroban-rpc.stellar.org

# Must be exactly this string.  validate-env.ts will fail if it does not match.
NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

# Horizon (mainnet)
HORIZON_URL=https://horizon.stellar.org

# Contract addresses — all required.
# Set these to the addresses from the official mainnet deployment.
CIRCLE_FACTORY_ADDRESS=
REPUTATION_ADDRESS=
USDC_ADDRESS=CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75

# Public key expected to administer the mainnet deployment. Never put a secret key here.
ADMIN_PUBLIC_KEY=
ADMIN_IDENTITY=

# Friendbot is NOT available on mainnet.
FRIENDBOT_URL=