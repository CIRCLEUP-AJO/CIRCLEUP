# CircleUp — Staging profile
#
# Targets a dedicated staging / pre-production network.
# All contract addresses MUST be set before deploying or starting any
# component with this profile.  validate-env.ts will fail if any are missing.
#
# Usage:
#   CIRCLEUP_PROFILE=staging npx ts-node scripts/src/validate-env.ts
#   (or) npx ts-node scripts/src/validate-env.ts --profile staging
#
# Rules applied by validate-env.ts for this profile:
#   - All contract addresses must be set (CIRCLE_FACTORY_ADDRESS, REPUTATION_ADDRESS, USDC_ADDRESS).
#   - NETWORK_PASSPHRASE must not be the public testnet passphrase.
#   - Secrets must never be stored in this file — use CI secrets or a secret manager.

CIRCLEUP_PROFILE=staging

# Replace with your staging RPC endpoint.
# Must NOT be soroban-testnet.stellar.org (that is the public testnet).
# Use a private testnet node, Futurenet, or a dedicated staging RPC.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org:443

# Must differ from the public testnet passphrase:
#   "Test SDF Network ; September 2015"
# If you are running your own network, set its passphrase here.
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Horizon
HORIZON_URL=https://horizon-testnet.stellar.org

# Contract addresses — all required for staging.
# Deploy contracts first, then fill in the addresses returned by the CLI.
CIRCLE_FACTORY_ADDRESS=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
REPUTATION_ADDRESS=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
USDC_ADDRESS=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Friendbot is disabled on private networks; funding must be done manually.
FRIENDBOT_URL=
