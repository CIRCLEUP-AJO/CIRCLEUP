# CircleUp — Testnet profile
#
# Targets the Stellar Testnet (Futurenet / SDF Testnet).
# Contract addresses may be empty; the deploy script will populate them
# after a fresh deployment.
#
# Usage:
#   CIRCLEUP_PROFILE=testnet npx ts-node scripts/src/validate-env.ts
#   (or) npx ts-node scripts/src/validate-env.ts --profile testnet
#
# Rules applied by validate-env.ts for this profile:
#   - Empty contract addresses are acceptable (local dev / fresh deploy).
#   - No passphrase check enforced.
#   - RPC URL must not be a mainnet endpoint.

CIRCLEUP_PROFILE=testnet

STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Contract addresses — leave blank until deployed; validate-env.ts will warn
# but not fail for the testnet profile.
CIRCLE_FACTORY_ADDRESS=
REPUTATION_ADDRESS=
USDC_ADDRESS=

# Friendbot faucet is available on testnet; operators may call it freely.
FRIENDBOT_URL=https://friendbot.stellar.org

# Horizon
HORIZON_URL=https://horizon-testnet.stellar.org
